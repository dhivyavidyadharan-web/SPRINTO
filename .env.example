DATABASE_URL=                     # Neon pooled connection string
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_SMART_MODEL=gemini-4-hydrogen
GEMINI_FAST_THINKING=low                # low|medium|high; low keeps extraction fast
GEMINI_SMART_THINKING=                  # empty = model default
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
MY_EMAIL=                         # ALL outbound email goes here (live test)
SENDER_NAME=
SENDER_TITLE=Growth, Sprinto
DASHBOARD_PASSWORD=
ENCRYPTION_KEY=                   # optional; defaults to a key derived from DASHBOARD_PASSWORD
CRON_SECRET=
JINA_API_KEY=                     # optional
CONTACT_SOURCE=db                 # db (CSV upload) | hunter
HUNTER_API_KEY=                   # optional
TIMEZONE=Asia/Kolkata
BUSINESS_HOURS_START=10:00
BUSINESS_HOURS_END=18:00
MEETING_MINUTES=30
BOOKING_WINDOW_DAYS=14            # never propose beyond this (hard max 30)
MAX_EXTRA_FETCHES=4
MAX_HTTP_REQUESTS_PER_COMPANY=12
MAX_NEGOTIATION_ROUNDS=3
FOLLOWUP_1_AFTER=7d               # supports m / h / d, e.g. 5m for demo
FOLLOWUP_2_AFTER=7d
BACKUP_REVISIT_NEGATIVE=90d
BACKUP_REVISIT_NO_REPLY=60d
NURTURE_REVISIT=60d
MAX_ACTIVE_RULES=10
DRY_RUN=false
